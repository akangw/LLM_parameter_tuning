{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllmtkb.local/schemas/topology-campaign-decision-v1.json",
  "title": "vLLMTKB topology Campaign Agent decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "incumbent_profile",
    "challenger_profile",
    "allocations",
    "summary",
    "evidence",
    "risk_assessment"
  ],
  "properties": {
    "action": {
      "enum": [
        "allocate_budget",
        "start_final_verification",
        "complete_campaign",
        "pause_for_human"
      ]
    },
    "incumbent_profile": {"type": ["string", "null"]},
    "challenger_profile": {"type": ["string", "null"]},
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "additional_candidate_rounds", "intent"],
        "properties": {
          "profile": {"type": "string", "minLength": 1},
          "additional_candidate_rounds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "intent": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "risk_assessment": {"type": "string", "minLength": 1}
  }
}
