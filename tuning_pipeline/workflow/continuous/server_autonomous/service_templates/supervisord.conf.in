[unix_http_server]
# AF_UNIX paths are limited to roughly 108 bytes on Linux. The renderer places
# this ephemeral socket at the approved workspace parent using a short,
# deployment-specific name.
file=@SUPERVISOR_SOCKET@
chmod=0700

[supervisord]
logfile=@SERVICE_ROOT@/supervisord.log
pidfile=@SERVICE_ROOT@/supervisord.pid
childlogdir=@SERVICE_ROOT@
nodaemon=false
minfds=1024

[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://@SUPERVISOR_SOCKET@

[program:vllmtkb-server-autonomous]
directory=@REPO_ROOT@
command=/bin/bash @RUNNER@ auto
environment=VLLMTKB_ENV_FILE="@ENV_FILE@",PYTHONUNBUFFERED="1"
autostart=true
autorestart=unexpected
exitcodes=0,78
startsecs=10
startretries=5
stopsignal=TERM
stopwaitsecs=86400
stopasgroup=false
killasgroup=true
stdout_logfile=@SERVICE_ROOT@/controller.stdout.log
stderr_logfile=@SERVICE_ROOT@/controller.stderr.log
stdout_logfile_maxbytes=20MB
stderr_logfile_maxbytes=20MB
stdout_logfile_backups=5
stderr_logfile_backups=5
