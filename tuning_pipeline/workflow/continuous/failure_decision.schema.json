{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "classification",
    "root_cause",
    "evidence",
    "action",
    "safe_to_automate",
    "change_strategy",
    "interaction_analysis",
    "constraint_checks",
    "changes",
    "recovery_changes",
    "candidate"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"action": {"const": "adjust_parameters"}},
        "required": ["action"]
      },
      "then": {
        "properties": {
          "classification": {
            "enum": [
              "parameter_invalid",
              "parameter_oom",
              "model_or_runtime_bug",
              "network_or_hccl",
              "transient_infrastructure",
              "image_or_dependency",
              "unknown"
            ]
          },
          "safe_to_automate": {"const": true},
          "change_strategy": {
            "enum": ["single_parameter", "coupled_parameters"]
          },
          "changes": {"minItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"action": {"const": "retry_same"}},
        "required": ["action"]
      },
      "then": {
        "properties": {
          "classification": {
            "enum": ["transient_infrastructure", "network_or_hccl", "benchmark_failure"]
          },
          "safe_to_automate": {"const": true},
          "change_strategy": {"const": "none"},
          "interaction_analysis": {"maxItems": 0},
          "constraint_checks": {"maxItems": 0},
          "changes": {"maxItems": 0},
          "recovery_changes": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"action": {"const": "pause_for_human"}},
        "required": ["action"]
      },
      "then": {
        "properties": {
          "safe_to_automate": {"const": false},
          "change_strategy": {"const": "none"},
          "interaction_analysis": {"maxItems": 0},
          "constraint_checks": {"maxItems": 0},
          "changes": {"maxItems": 0},
          "recovery_changes": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"action": {"const": "diagnostic_retry_same"}},
        "required": ["action"]
      },
      "then": {
        "properties": {
          "classification": {
            "enum": [
              "parameter_invalid",
              "parameter_oom",
              "transient_infrastructure",
              "network_or_hccl",
              "image_or_dependency",
              "model_or_runtime_bug",
              "benchmark_failure",
              "unknown"
            ]
          },
          "safe_to_automate": {"const": true},
          "change_strategy": {"const": "none"},
          "interaction_analysis": {"maxItems": 0},
          "constraint_checks": {"maxItems": 0},
          "changes": {"maxItems": 0},
          "recovery_changes": {"maxItems": 0}
        }
      }
    }
  ],
  "properties": {
    "summary": {"type": "string"},
    "classification": {
      "type": "string",
      "enum": [
        "parameter_invalid",
        "parameter_oom",
        "transient_infrastructure",
        "network_or_hccl",
        "image_or_dependency",
        "model_or_runtime_bug",
        "benchmark_failure",
        "unknown"
      ]
    },
    "root_cause": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "action": {
      "type": "string",
      "enum": [
        "adjust_parameters",
        "retry_same",
        "diagnostic_retry_same",
        "pause_for_human"
      ]
    },
    "safe_to_automate": {"type": "boolean"},
    "change_strategy": {
      "type": "string",
      "enum": ["none", "single_parameter", "coupled_parameters"]
    },
    "interaction_analysis": {
      "type": "array",
      "items": {"type": "string", "minLength": 12}
    },
    "constraint_checks": {
      "type": "array",
      "items": {"type": "string", "minLength": 12}
    },
    "changes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter", "before", "after", "rationale"],
        "properties": {
          "parameter": {"type": "string"},
          "before": {
            "anyOf": [
              {"type": "string"},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "null"},
              {"type": "array", "items": {"type": ["string", "number", "boolean", "null"]}}
            ]
          },
          "after": {
            "anyOf": [
              {"type": "string"},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "null"},
              {"type": "array", "items": {"type": ["string", "number", "boolean", "null"]}}
            ]
          },
          "rationale": {"type": "string", "minLength": 12}
        }
      }
    },
    "recovery_changes": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter", "before", "after", "rationale"],
        "properties": {
          "parameter": {"type": "string"},
          "before": {
            "anyOf": [
              {"type": "string"},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "null"}
            ]
          },
          "after": {
            "anyOf": [
              {"type": "string"},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "null"}
            ]
          },
          "rationale": {"type": "string", "minLength": 12}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_num_seqs",
        "max_model_len",
        "max_num_batched_tokens",
        "gpu_memory_utilization",
        "enable_prefix_caching",
        "async_scheduling",
        "enable_expert_parallel",
        "compilation_mode",
        "num_speculative_tokens",
        "long_prefill_token_threshold"
      ],
      "properties": {
        "max_num_seqs": {"type": "integer"},
        "max_model_len": {"type": "integer"},
        "max_num_batched_tokens": {"type": "integer"},
        "gpu_memory_utilization": {"type": "number"},
        "enable_prefix_caching": {"type": "boolean"},
        "async_scheduling": {"type": "boolean"},
        "enable_expert_parallel": {"type": "boolean"},
        "compilation_mode": {"type": "string"},
        "num_speculative_tokens": {"type": "integer"},
        "long_prefill_token_threshold": {"type": "integer"}
      }
    }
  }
}
